SECRET_KEY=dev-secret-key-example
SQLALCHEMY_DATABASE_URI=postgresql://DATABASE_USERNAME:DATABASE_PASSWORD@DATABASE_HOSTNAME:DATABASE_PORT/DATABASE_NAME
SQLALCHEMY_TRACK_MODIFICATIONS=False

JWT_SECRET_KEY=your_access_token_secret_key
JWT_REFRESH_SECRET_KEY=your_refresh_token_secret_key
JWT_ALGORITHM=HS256                                                                       # Or RS256 if using asymmetric keys or any other algorithm used for signing the JWTs
JWT_TOKEN_LOCATION=cookies
JWT_COOKIE_SECURE=False
JWT_COOKIE_CSRF_PROTECT=True
JWT_ACCESS_COOKIE_PATH=/api
JWT_REFRESH_COOKIE_PATH=/api/auth/refresh
JWT_COOKIE_SAMESITE=Lax

ACCESS_TOKEN_EXPIRE_TIME=access_token_exipry_time                                         # e.g., "30m", "1h", "1d"
REFRESH_TOKEN_EXPIRE_TIME=refresh_token_exipry_time                                       # e.g., "16h", "7d", "30d"

SQLALCHEMY_TESTING_DATABASE_URI=sqlite:///:memory: