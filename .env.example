SECRET_KEY=dev-secret-key-example
DATABASE_URI=postgresql://DATABASE_USERNAME:DATABASE_PASSWORD@DATABASE_HOSTNAME:DATABASE_PORT/DATABASE_NAME
SQLALCHEMY_DB_TRACK_MODIFICATION=False
ACCESS_TOKEN_SECRET_KEY=your_access_token_secret_key
REFRESH_TOKEN_SECRET_KEY=your_refresh_token_secret_key
JWT_LOCATION=headers
JWT_ALGO=HS256                                                     # Or RS256 if using asymmetric keys or any other algorithm used for signing the JWTs
ACCESS_TOKEN_EXPIRE_TIME=access_token_exipry_time                  # e.g., "30m", "1h", "1d"
REFRESH_TOKEN_EXPIRE_TIME=refresh_token_exipry_time                # e.g., "16h", "7d", "30d"
SQLALCHEMY_TESTING_DATABASE_URI="sqlite:///:memory:"